[Unit]
Description=Omarchy V2Ray manager (sing-box TUN mode, user session)
After=network-online.target
Wants=network-online.target

[Service]
# Runs as the invoking user (substituted for %i by scripts/install.sh).
# sing-box needs CAP_NET_ADMIN for the TUN device; granted via ambient caps,
# bounded. Config path is user-owned and root-validated by the CLI before use.
User=%i
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
NoNewPrivileges=yes
ExecStart=/usr/bin/sing-box run -c %h/.config/v2ray-manager/config-tun.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

